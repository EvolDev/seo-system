# Шаблон переменных окружения. Скопировать в .env и заполнить пустые значения.
# Полный список и пояснения — docs/13-CONFIG.md §1.
# Сейчас здесь только то, что нужно для запуска (E0-01); остальное — E0-02.

# --- Общее ---
DJANGO_ENV=local                 # local | prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/Moscow

# --- База ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=seo
POSTGRES_USER=seo
POSTGRES_PASSWORD=

# --- Очереди ---
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false   # true в тестах
