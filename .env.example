# Шаблон переменных окружения. Скопировать в .env и заполнить пустые значения.
# Полный список и пояснения — docs/13-CONFIG.md §1; при правке менять оба места.
# Пустое значение — «не задано»: переменная, которую читают настройки, без
# значения роняет старт. Ключи внешних API читает задача, которой они нужны.

# --- Общее ---
DJANGO_ENV=local                 # local | prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/Moscow

# --- База ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=seo
POSTGRES_USER=seo
POSTGRES_PASSWORD=

# --- Вход и сессия --- ADR-081
SESSION_DAYS=14                  # не заходил столько дней — входит заново
LOGIN_FAIL_LIMIT=10              # столько неверных паролей подряд — вход закрыт
LOGIN_FAIL_MINUTES=15            # на столько минут после последней неудачи
LOGIN_OTP_REQUIRED=false         # true — после пароля код из Google Authenticator; в проде включён и без строки

# --- Прод: адрес и веб-сервер --- compose.prod.yaml, ADR-081; локально не нужны
SITE_ADDRESS=                    # домен системы для Caddy: seo.example.com
SITE_PATH=                       # секретный путь: система — <адрес>/<путь>/, на сервере обязателен; пусто — /admin/
SECURE_HSTS_SECONDS=0            # «только HTTPS» в браузере; после проверки HTTPS — 31536000
WEB_WORKERS=3                    # процессов gunicorn

# --- Бэкапы --- E10-03, ADR-081; только прод (compose.prod.yaml, контейнер backup)
BACKUP_MONITOR=false             # true — раз в час проверять архив, бэкапы и диск
PG_ARCHIVE_MODE=off              # on — изменения базы в течение минуты уходят в архив B2
B2_ENDPOINT=                     # https://s3.<регион>.backblazeb2.com
B2_REGION=                       # регион из адреса: eu-central-003
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
BACKUP_R2_ENABLED=false          # true — ночная копия ещё и в Cloudflare R2 (вторая компания)
R2_ENDPOINT=                     # https://<номер аккаунта>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_WALG_KEY=                 # 64 знака hex; без него архив не прочитать — копия в менеджере паролей
BACKUP_FILES_PASSWORD=           # шифрует дампы и файлы; без него их не прочитать — копия там же
BACKUP_MAX_AGE_HOURS=26          # снимок, дамп и файлы старше — оповещение
RESTORE_TEST_MAX_AGE_DAYS=8      # проверка восстановления старше — оповещение
WAL_ARCHIVE_MAX_AGE_MINUTES=120  # изменения не уходили в архив дольше — оповещение
DISK_ALERT_PERCENT=80            # диск занят больше — оповещение

# --- Очереди ---
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false   # true — задачи сразу, без воркера; тесты включают сами

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=
LLM_MAX_COST_PER_CHAIN_CENTS=200 # предохранитель на одну цепочку
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# --- Эмбеддинги (E6-06, E5-03) --- у Anthropic своей модели нет, ADR-022
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=voyage-4-lite

# --- SERP --- выдача Google, ADR-040
SERP_PROVIDER=serper             # serper
SERPER_API_KEY=
SERPER_CENTS_PER_1000=100        # цена 1000 кредитов купленного пакета, центы
SERP_DAILY_BUDGET_CENTS=500      # больше за сутки — поиск встаёт до полуночи
SERP_CACHE_HOURS=24              # одинаковый запрос столько часов — из кеша

# --- Ahrefs ---
AHREFS_API_KEY=
AHREFS_ENABLED=false             # см. Q2, пока не подтверждён доступ
AHREFS_DAILY_UNITS_LIMIT=50000

# --- Collaborator --- сделки по кнопке, только чтение, ADR-079
COLLABORATOR_API_KEY=            # профиль на collaborator.pro → «API» → токен

# --- Краулер ---
CRAWLER_USER_AGENT=
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_MAX_REDIRECTS=5
CRAWLER_RATE_LIMIT_PER_DOMAIN=1  # запросов в секунду

# --- Уведомления ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=                      # до прода GlitchTip, в проде sentry.io — ADR-026

# --- Продукты ---
PRIMARY_PRODUCT_DOMAIN=convertio.co
