# Caddy перед приложением (E10-01, ADR-081): HTTPS с сертификатом Let's Encrypt,
# который он получает и продлевает сам, сжатие, журнал запросов в stdout.
# SITE_ADDRESS — домен системы (seo.example.com). Для «localhost» на тестовой
# копии сертификат выпускает внутренний центр Caddy: браузер предупредит, что
# не доверяет ему, — на сервере с доменом предупреждения нет.
# SITE_PATH — секретный путь (ADR-081): вся система живёт под /<путь>/, на любой
# другой адрес — главную, /admin, /wp-admin — Caddy обрывает соединение без
# ответа, как 444 в nginx. Боты, перебирающие адреса, не находят даже формы входа.

{
	# HTTP/3 идёт по UDP — этот порт не открыт; без него браузер не пробует
	# напрасно другой протокол.
	servers {
		protocols h1 h2
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Файлы каталога Collaborator и прайсов — до 100 МБ.
	request_body {
		max_size 100MB
	}

	@system path /{$SITE_PATH} /{$SITE_PATH}/*
	handle @system {
		reverse_proxy app:8000
	}
	handle {
		abort
	}

	log {
		output stdout
		format json
	}
}
